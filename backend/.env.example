# File MẪU - được commit vào git.
# Cách dùng: copy thành .env rồi điền giá trị thật.
#   cp .env.example .env
#
# File .env thật KHÔNG được commit (đã chặn trong .gitignore).
# Giữ file mẫu này để người khác (hoặc chính mình vài tháng sau)
# biết hệ thống cần những biến môi trường nào mà không phải đọc code.

# ------------------------------------------------------------
# Kết nối cơ sở dữ liệu
# ------------------------------------------------------------
# Cổng 5434 (không phải 5432/5433) - xem lý do trong docker-compose.yml:
# máy phát triển đã có 2 PostgreSQL khác chiếm 2 cổng đó.
# Tiền tố BẮT BUỘC là postgresql+psycopg:// vì dự án dùng psycopg 3.
# Viết postgresql:// không thôi sẽ lỗi "No module named 'psycopg2'".
DATABASE_URL=postgresql+psycopg://thesis:thesis_dev_password@localhost:5434/thesis_analytics

# ------------------------------------------------------------
# Quy tắc nghiệp vụ (SPEC §9.1)
# ------------------------------------------------------------
# Ngưỡng cảnh báo: doanh thu kỳ này giảm quá bao nhiêu % so với kỳ
# trước thì báo động. Để ở đây thay vì hard-code để còn tinh chỉnh
# sau khi xin ý kiến GVHD mà không phải sửa code.
# Giá trị dương, hiểu là "giảm quá X phần trăm".
ALERT_DROP_THRESHOLD_PCT=30
# Origin của frontend được gọi API (CORS), dạng JSON; mặc định http://localhost:5173 (Vite dev)
# CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# ------------------------------------------------------------
# Ứng dụng
# ------------------------------------------------------------
# Bật chế độ phát triển: log chi tiết hơn, tự nạp lại khi sửa code.
# File mẫu để false — giá trị an toàn cho demo/nộp bài. Máy đang phát
# triển thì sửa thành true trong .env của mình.
DEBUG=false

# ------------------------------------------------------------
# Đường API (SPEC §18, §20.4) — thêm ở bước 9a
# ------------------------------------------------------------
# Mặc định trỏ máy chủ giả lập (mock_platform, cổng 8001). Đổi sang sàn thật
# chỉ cần sửa 3 URL này và khóa bên dưới.
SHOPEE_BASE_URL=http://127.0.0.1:8001
TIKTOK_BASE_URL=http://127.0.0.1:8001
TIKTOK_AUTH_BASE_URL=http://127.0.0.1:8001

# Khóa ứng dụng và token ban đầu — MỌI GIÁ TRỊ LÀ GIẢ, trùng tên và trùng giá
# trị với mock_platform/.env.example (quy ước §20.4). KHÔNG chép khóa thật từ
# thư mục Pipeline/ vào đây (QUY_TRINH §2.5).
# Token ban đầu chỉ dùng để nạp sẵn bảng platform_tokens khi bảng chưa có dòng
# của shop đó; đã có dòng thì không ghi đè.
SHOPEE_PARTNER_ID=100001
SHOPEE_PARTNER_KEY=mock_shopee_partner_key_GIA
SHOPEE_SHOP_ID=200001
SHOPEE_SHOP_NAME=Shop C
SHOPEE_ACCESS_TOKEN=mock_shopee_access_GIA
SHOPEE_REFRESH_TOKEN=mock_shopee_refresh_GIA

TIKTOK_APP_KEY=mockappkeyGIA
TIKTOK_APP_SECRET=mock_tiktok_app_secret_GIA
# shop_cipher: máy chủ giả lập đặt cố định trong data_builder.py (§19.4).
TIKTOK_SHOP_A_NAME=Shop A
TIKTOK_SHOP_A_CIPHER=MOCK_CIPHER_SHOP_A
TIKTOK_SHOP_A_ACCESS_TOKEN=mock_tiktok_shop_a_access_GIA
TIKTOK_SHOP_A_REFRESH_TOKEN=mock_tiktok_shop_a_refresh_GIA
TIKTOK_SHOP_B_NAME=Shop B
TIKTOK_SHOP_B_CIPHER=MOCK_CIPHER_SHOP_B
TIKTOK_SHOP_B_ACCESS_TOKEN=mock_tiktok_shop_b_access_GIA
TIKTOK_SHOP_B_REFRESH_TOKEN=mock_tiktok_shop_b_refresh_GIA

# ------------------------------------------------------------
# Tác vụ đồng bộ (SPEC §20.3, §20.4) — bỏ trống thì dùng mặc định
# ------------------------------------------------------------
# SYNC_INTERVAL_MINUTES=10
# SYNC_LOOKBACK_DAYS=3
# SYNC_BACKFILL_FROM=2026-01-01
# TOKEN_EXPIRING_DAYS=7
