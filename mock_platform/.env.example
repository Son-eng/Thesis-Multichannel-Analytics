# File MẪU của máy chủ giả lập — được commit vào git.
# Cách dùng: cp .env.example .env
#
# ============================================================
# MỌI GIÁ TRỊ DƯỚI ĐÂY LÀ GIẢ.
# Không phải khóa hay token của bất kỳ app / shop thật nào.
# KHÔNG BAO GIỜ chép khóa thật từ thư mục Pipeline/ vào đây.
# ============================================================
#
# Backend dùng CÙNG các giá trị này trong backend/.env, như một app đã đăng
# ký với "sàn" giả lập.

# ------------------------------------------------------------
# Shopee (1 shop: Shop C)
# ------------------------------------------------------------
SHOPEE_PARTNER_ID=100001
SHOPEE_PARTNER_KEY=mock_shopee_partner_key_GIA
SHOPEE_SHOP_ID=200001
# Token ban đầu, nạp sẵn: máy chủ giả lập không có bước đổi mã ủy quyền.
SHOPEE_ACCESS_TOKEN=mock_shopee_access_GIA
SHOPEE_REFRESH_TOKEN=mock_shopee_refresh_GIA

# ------------------------------------------------------------
# TikTok Shop (2 shop: Shop A, Shop B — mỗi shop một token)
# ------------------------------------------------------------
TIKTOK_APP_KEY=mockappkeyGIA
TIKTOK_APP_SECRET=mock_tiktok_app_secret_GIA
TIKTOK_SHOP_A_ACCESS_TOKEN=mock_tiktok_shop_a_access_GIA
TIKTOK_SHOP_A_REFRESH_TOKEN=mock_tiktok_shop_a_refresh_GIA
TIKTOK_SHOP_B_ACCESS_TOKEN=mock_tiktok_shop_b_access_GIA
TIKTOK_SHOP_B_REFRESH_TOKEN=mock_tiktok_shop_b_refresh_GIA

# ------------------------------------------------------------
# Ủy quyền gian hàng (tùy chọn, có mặc định như dưới đây).
# service_id GIẢ của app TikTok và Redirect URL đã đăng ký (backend nhận kết quả ở đó).
# ------------------------------------------------------------
# TIKTOK_SERVICE_ID=mock_service_id_GIA
# TIKTOK_REDIRECT_URL=http://localhost:8000/api/connections/tiktok/callback

# ------------------------------------------------------------
# Hạn sống access_token (giây). Bỏ trống = đúng như sàn thật:
# Shopee 14400 (4 giờ), TikTok 604800 (7 ngày).
# Đặt số nhỏ để test token hết hạn mà không phải chờ.
# ------------------------------------------------------------
# MOCK_SHOPEE_ACCESS_TTL_SECONDS=14400
# MOCK_TIKTOK_ACCESS_TTL_SECONDS=604800

# ------------------------------------------------------------
# Escrow Shopee
#   all            = trả escrow cho mọi đơn (mặc định — số liệu khớp số liệu chuẩn)
#   completed_only = đơn khác COMPLETED bị báo lỗi → kiểm nhánh NMV tạm tính
# ------------------------------------------------------------
MOCK_ESCROW_MODE=all

# ------------------------------------------------------------
# Gây lỗi quá tải có chủ đích — kiểm cơ chế thử lại
#   MOCK_FAULT_RATE  : tỷ lệ 0–1 yêu cầu bị trả lỗi (Shopee HTTP 429 +
#                      error_rate_limit, TikTok code 36009002). 0 = tắt.
#   MOCK_FAULT_SEED  : số nguyên cố định chuỗi lỗi (tái lập được); bỏ trống = ngẫu nhiên.
# ------------------------------------------------------------
MOCK_FAULT_RATE=0
# MOCK_FAULT_SEED=42
